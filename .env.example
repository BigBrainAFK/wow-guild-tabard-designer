# Path to a World of Warcraft install (the folder containing .build.info). Optional on servers: without it the
# app uses the texture pack in TEXTURE_DIR, which `npm run extract` builds on a machine that has the game.
WOW_PATH=E:/Meine_Daten/Blizzard/World of Warcraft
# Product code from .build.info: wowf (Forever), wow (Retail), wow_classic_era, wow_classic ...
WOW_PRODUCT=wowf
# Where the WebP texture pack and the Wowhead model mirror live.
# TEXTURE_DIR=data/textures
# MODEL_DIR=data/zam
PORT=5173

# --- Server deployment ---
# Addresses to listen on, comma-separated. The default is localhost over IPv4 and IPv6 (127.0.0.1,::1); keep it and put a reverse proxy (TLS) in front; dev mode refuses anything else.
# HOST=127.0.0.1,::1
# Behind a reverse proxy: use X-Forwarded-For as the client address for rate limits.
# TRUST_PROXY=1
# off: serve model data only from MODEL_DIR (filled by `npm run fetch-models`), never contact Wowhead's CDN.
# MODEL_FETCH=off
