{
  "name": "wow-tabard-designer",
  "version": "0.1.0",
  "private": true,
  "description": "Visual WoW guild tabard editor with a live 3D character preview",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/main.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/main.ts --prod",
    "extract": "node --env-file-if-exists=.env scripts/extract-textures.ts",
    "typecheck": "tsc --noEmit",
    "fetch-models": "node --env-file-if-exists=.env scripts/fetch-models.ts"
  },
  "dependencies": {
    "@solidjs/web": "^2.0.3",
    "jquery": "^3.8.0",
    "sharp": "^0.35.5",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.1",
    "@types/jquery": "^3.5.34",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
